{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@core/*": ["./packages/core/src/*"],
      "@content/*": ["./content/*"]
    }
  },
  "include": ["apps/desktop/src", "packages/core", "content"]
}
